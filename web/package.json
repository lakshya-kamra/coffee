{
  "name": "coffee-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Coffee on the web: brew timer, brew log and grind notes. Same data and backup file as the Android app.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "node scripts/gen-tokens.mjs",
    "smoke": "node scripts/smoke.mjs",
    "vercel-sim": "node scripts/vercel-sim.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "check-deploy": "node scripts/check-deploy.mjs"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@eslint/js": "9.39.5",
    "@rolldown/plugin-babel": "0.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
