  "processes": [
    {
      "id": "washed",
      "label": "Washed",
      "group": "classic",
      "description": "Fruit is removed before drying, so the cup tastes clean and bright with clear acidity."
    },
    {
      "id": "kenyan-washed",
      "label": "Washed (double soak / Kenyan style)",
      "group": "classic",
      "description": "Kenyan-style washed: depulped coffee is fermented and washed, often fermented a second time, then soaked under clean water before drying; known for very clean, juicy cups."
    },
    {
      "id": "natural",
      "label": "Natural (dry process)",
      "group": "classic",
      "description": "Whole cherries dry with the fruit on, giving sweeter, fruitier, heavier cups."
    },
    {
      "id": "semi-washed",
      "label": "Semi-washed",
      "group": "classic",
      "description": "A loose term: in Latin America it usually means partly removed fruit, in Indonesia it often means wet-hulled. Ask the roaster."
    },
    {
      "id": "wet-hulled",
      "label": "Wet-hulled (giling basah)",
      "group": "classic",
      "description": "Indonesian method where the parchment comes off while the bean is still wet; earthy, herbal, heavy-bodied cups."
    },
    {
      "id": "honey",
      "label": "Honey (unspecified)",
      "group": "honey",
      "description": "Skin removed but some sticky fruit (mucilage) left on while drying; sweet and rounded, between washed and natural."
    },
    {
      "id": "honey-white",
      "label": "White honey",
      "group": "honey",
      "description": "Honey with very little fruit left on; closest to washed in taste."
    },
    {
      "id": "honey-yellow",
      "label": "Yellow honey",
      "group": "honey",
      "description": "Honey with a light layer of fruit left on; a little sweeter than white honey."
    },
    {
      "id": "honey-red",
      "label": "Red honey",
      "group": "honey",
      "description": "Honey with most of the fruit left on and slower drying; noticeably sweet and fruity."
    },
    {
      "id": "honey-black",
      "label": "Black honey",
      "group": "honey",
      "description": "Honey with nearly all the fruit left on and the slowest drying; closest to a natural, rich and jammy."
    },
    {
      "id": "pulped-natural",
      "label": "Pulped natural",
      "group": "honey",
      "description": "Brazilian take on honey: skin removed by machine, fruit left on to dry; sweet, nutty, rounded."
    },
    {
      "id": "anaerobic",
      "label": "Anaerobic (unspecified)",
      "group": "fermentation",
      "description": "Fermented in sealed, oxygen-free tanks; the bag does not say whether it was then dried as a natural, honey or washed."
    },
    {
      "id": "anaerobic-natural",
      "label": "Anaerobic natural",
      "group": "fermentation",
      "description": "Whole cherries fermented in sealed, oxygen-free tanks before drying; intense, winey, boozy fruit."
    },
    {
      "id": "anaerobic-washed",
      "label": "Anaerobic washed",
      "group": "fermentation",
      "description": "Depulped beans fermented in sealed tanks, then washed; cleaner than anaerobic natural but still punchy."
    },
    {
      "id": "anaerobic-honey",
      "label": "Anaerobic honey",
      "group": "fermentation",
      "description": "Honey-processed beans fermented in sealed tanks before drying; sweet with extra fermented fruit notes."
    },
    {
      "id": "carbonic-maceration",
      "label": "Carbonic maceration",
      "group": "fermentation",
      "description": "Borrowed from winemaking: cherries ferment in tanks flushed with CO2; bright, candied, wine-like flavours."
    },
    {
      "id": "double-fermentation",
      "label": "Double fermentation",
      "group": "fermentation",
      "description": "Two fermentation stages (often cherry then parchment) to build more complexity and sweetness."
    },
    {
      "id": "extended-fermentation",
      "label": "Extended fermentation",
      "group": "fermentation",
      "description": "Fermentation left much longer than usual (days rather than hours); deeper, funkier fruit."
    },
    {
      "id": "yeast-inoculated",
      "label": "Yeast-inoculated",
      "group": "fermentation",
      "description": "A chosen yeast strain is added to steer fermentation toward specific flavours, like in brewing or wine."
    },
    {
      "id": "lactic",
      "label": "Lactic fermentation",
      "group": "fermentation",
      "description": "Fermentation that favours lactic-acid bacteria; creamy, yoghurt-like or soft-cheese sweetness and round acidity."
    },
    {
      "id": "thermal-shock",
      "label": "Thermal shock",
      "group": "fermentation",
      "description": "After fermentation the coffee is rinsed with hot water, then cold water; producers say this fixes aromatics. Popularised in Colombia and often combined with co-fermentation, so check whether flavour was added."
    },
    {
      "id": "koji",
      "label": "Koji fermentation",
      "group": "fermentation",
      "description": "Beans or cherries inoculated with koji mould (the culture used for sake and soy sauce); savoury-sweet, umami-leaning."
    },
    {
      "id": "co-fermented",
      "label": "Co-fermented / infused (flavour added)",
      "group": "fermentation",
      "description": "INFUSED: fruit, spices, juice or flavourings are added during fermentation, so some flavour comes from the additive, not the coffee itself."
    },
    {
      "id": "monsooned",
      "label": "Monsooned",
      "group": "other",
      "description": "Indian method where dried beans are exposed to monsoon winds for weeks; low acid, heavy, woody and spicy."
    },
    {
      "id": "barrel-aged",
      "label": "Barrel-aged (flavour added)",
      "group": "other",
      "description": "INFUSED: green beans rest in used spirit or wine barrels and take on the barrel's flavour."
    },
    {
      "id": "decaf",
      "label": "Decaf-processed",
      "group": "other",
      "description": "Caffeine removed from the green beans; pick the decaf method separately if the bag names it."
    },
    {
      "id": "experimental",
      "label": "Experimental / other",
      "group": "other",
      "description": "A producer's own method that does not fit the usual names; check the roaster's notes."
    },
    {
      "id": "unknown",
      "label": "Not listed",
      "group": "other",
      "description": "The bag does not say how the coffee was processed."
    }
  ],
